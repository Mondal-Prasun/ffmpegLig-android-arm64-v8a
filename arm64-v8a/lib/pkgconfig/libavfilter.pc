prefix=/root/FFmpeg/android/arm64-v8a
exec_prefix=${prefix}
libdir=/root/FFmpeg/android/arm64-v8a/lib
includedir=/root/FFmpeg/android/arm64-v8a/include

Name: libavfilter
Description: FFmpeg audio/video filtering library
Version: 11.12.100
Requires: 
Requires.private: libswscale >= 9.3.100, libavformat >= 62.9.101, libavcodec >= 62.23.103, libswresample >= 6.2.100, libavutil >= 60.25.100
Conflicts:
Libs: -L${libdir}  -lavfilter 
Libs.private: -pthread -lm -latomic -lz
Cflags: -I${includedir}
