prefix=/root/FFmpeg/android/arm64-v8a
exec_prefix=${prefix}
libdir=/root/FFmpeg/android/arm64-v8a/lib
includedir=/root/FFmpeg/android/arm64-v8a/include

Name: libavformat
Description: FFmpeg container format library
Version: 62.9.101
Requires: 
Requires.private: libavcodec >= 62.23.103, libswresample >= 6.2.100, libavutil >= 60.25.100
Conflicts:
Libs: -L${libdir}  -lavformat 
Libs.private: -lm -latomic -lz
Cflags: -I${includedir}
