prefix=/root/FFmpeg/android/arm64-v8a
exec_prefix=${prefix}
libdir=/root/FFmpeg/android/arm64-v8a/lib
includedir=/root/FFmpeg/android/arm64-v8a/include

Name: libavcodec
Description: FFmpeg codec library
Version: 62.23.103
Requires: 
Requires.private: libswresample >= 6.2.100, libavutil >= 60.25.100
Conflicts:
Libs: -L${libdir}  -lavcodec 
Libs.private: -pthread -lm -latomic -lz
Cflags: -I${includedir}
